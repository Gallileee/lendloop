# Copy to .env (never commit it) only if you want PostgreSQL instead of the default H2 file database.
# Spring Boot reads these environment variables directly.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lendloop
SPRING_DATASOURCE_USERNAME=lendloop
SPRING_DATASOURCE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# Port the app listens on (default 8080).
PORT=8080

# Due-date reminder emails. Without SPRING_MAIL_HOST they are only written to the log.
# These values point at the Mailpit container from compose.yaml (inbox: http://localhost:8025).
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# Address used in the emails' links, and the sender.
BASE_URL=http://localhost:8080
MAIL_FROM=Lendloop <no-reply@lendloop.local>
# Signs the one-click unsubscribe links in emails; at least 32 characters.
# Generate one with: openssl rand -base64 32
# Empty = a random secret per run (fine locally, links break on restart).
UNSUBSCRIBE_SECRET=
# When the job runs (Spring cron: second minute hour day month weekday); "-" turns it off.
REMINDERS_CRON=0 0 8 * * *
